{
  "key": "domain-list",
  "flow": "sys-functions",
  "domain": "discovery",
  "version": "1.0.0",
  "flowVersion": "1.0.0",
  "tags": [
    "domain",
    "discovery",
    "list",
    "cache",
    "read"
  ],
  "attributes": {
    "scope": "D",
    "rawResponse": true,
    "verbs": [
      "GET"
    ],
    "labels": [
      {
        "language": "en-US",
        "label": "Active Domain List"
      },
      {
        "language": "tr-TR",
        "label": "Aktif Domain Listesi"
      }
    ],
    "cache": {
      "key": "discovery:domains:active",
      "ttlInSeconds": 86400,
      "consistency": "Eventual",
      "bypassOnCacheError": true
    },
    "task": {
      "order": 1,
      "task": {
        "key": "get-domain-instances",
        "domain": "discovery",
        "flow": "sys-tasks",
        "version": "1.0.0"
      },
      "mapping": {
        "type": "L",
        "location": "./src/DomainListMapping.csx",
        "encoding": "B64",
        "code": ""
      }
    },
    "output": {
      "type": "L",
      "location": "./src/DomainListOutput.csx",
      "encoding": "B64",
      "code": ""
    }
  }
}